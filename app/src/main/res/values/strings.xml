    <string name="log_out">Log out</string>
    <string name="log_out_title">Log out?</string>
    <string name="log_out_text">The folders stay on the list and their files stay where they are. After the next login, the first sync compares the files on both sides again.</string>
    <string name="auto_sync">Sync every 15 minutes</string>
    <string name="auto_sync_detail">In the background, when there is a network. Android may wait longer while the phone sleeps.</string>
    <string name="no_folders">No folders yet. Add a folder on this phone and the Nextcloud folder to keep it in step with.</string>
    <string name="tile_hint">Tip: add the “Sync now” tile to the quick settings, and tap it before and after using a synced folder on another device.</string>
    <string name="sync_all">Sync all</string>
    <string name="sync_now">Sync now</string>
