    <string name="app_name" translatable="false">YA?NS</string>
    <string name="app_expanded">Yet Another (?) Nextcloud Sync</string>
    <string name="login_intro">Two-way sync of folders on this phone with folders on your Nextcloud. Log in to start.</string>
