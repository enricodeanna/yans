        <item quantity="one">%1$d conflict, the older copy kept: %2$s</item>
        <item quantity="other">%1$d conflicts, the older copies kept: %2$s</item>
    </plurals>
    <plurals name="failed">
        <item quantity="one">%1$d file not synced: %2$s</item>
        <item quantity="other">%1$d files not synced, such as %2$s</item>
