    <string name="one_way_hint">New and changed files go one way only. A file deleted on either side is not deleted on the other, and one changed on the receiving side is replaced, its own version kept as a conflict copy.</string>
    <string name="direction_changed">The next sync will compare all the files on both sides again.</string>
    <string name="keep_on_server">On Nextcloud, keep only</string>
    <string name="keep_on_phone">On the phone, keep only</string>
    <string name="keep_newest_before">the newest</string>
    <string name="keep_newest_after">files</string>
    <string name="keep_days_before">the files of the last</string>
    <string name="keep_days_after">days</string>
    <string name="keep_server_hint">With both, only files within both. The others are deleted on Nextcloud, to its trash bin, and are not sent. Every file in the Nextcloud folder counts, sent from here or not.</string>
    <string name="keep_phone_hint">With both, only files within both. The others are deleted from the phone, for good, and are not received. Every file in the phone\'s folder counts, received or not.</string>
